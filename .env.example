# Copy to .env and fill in. Git ignores .env, and the agent hooks and ignore files keep agents out of it.
# List every variable the project reads, with a comment on what it is for. Never put a real value here.
# The SQLite file the web app opens (`pnpm start`). Migrations run on start.
BEANQUERY_DB=beans.db
# Where the web app listens. Keep HOST on localhost behind the reverse proxy.
PORT=3000
HOST=127.0.0.1
# Set to false only for local development over plain HTTP: the session cookie then drops Secure and the __Host-
# prefix. Never set it on the server.
# SECURE_COOKIES=false
# The public origin forms must come from, behind the proxy, such as https://beans.example. Unset means the request's own.
PUBLIC_ORIGIN=
# true behind a reverse proxy on the same host, so rate limits key on the client in X-Forwarded-For.
TRUST_PROXY=false
