#!/bin/sh
# Fast checks before every commit, enabled by `pnpm run setup`. CI runs the full `pnpm verify`.
set -e
node scripts/check-tracked-files.mjs --staged
node scripts/check-docs.mjs
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --config .gitleaks.toml
fi
