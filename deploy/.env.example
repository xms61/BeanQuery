# The VPS's settings for deploy/compose.yml. Copy to .env next to compose.yml on the VPS (docs/DEPLOY.md).
# HOST, PORT, BEANQUERY_DB, TRUST_PROXY and SECURE_COOKIES are set in compose.yml and can't be changed here.

# The public origin forms must come from: https:// and the domain in beanquery.caddy.
PUBLIC_ORIGIN=https://beans.example.org

# The time zone for accounts whose browser has not reported one yet.
DEFAULT_TIME_ZONE=Europe/Berlin

# The folder on the VPS for the nightly backups, owned by uid 1000 (the container's user).
BEANQUERY_BACKUP_DIR=/srv/beanquery/backups

# The image version to run, such as 0.2.0. Leave unset for the latest release; set it to roll back.
# BEANQUERY_VERSION=
