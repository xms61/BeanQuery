{
  "name": "beanquery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "verify": "npm run check:files && npm run check:docs && npm run lint && npm run typecheck && npm test && npm run test:scripts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:files": "node scripts/check-tracked-files.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
