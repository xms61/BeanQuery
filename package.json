{
  "name": "beanquery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "verify": "pnpm check:files && pnpm check:docs && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:files": "node scripts/check-tracked-files.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "roasters:import": "tsc && node dist/roaster/cli.js",
    "contract:schema": "tsc && node dist/contract/write-schema.js",
    "map:build": "tsc && node dist/stats/world-map-cli.js",
    "admin": "tsc && node dist/account/cli.js",
    "ops": "tsc && node dist/ops/cli.js",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "start": "tsc && node --env-file-if-exists=.env dist/web/server.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "chart.js": "4.5.1",
    "hono": "4.13.13",
    "zod": "4.6.5"
  }
}
